# Copy to .env for local development with `netlify dev`.
# In production set these in Netlify -> Site configuration -> Environment variables.
# Generate the hash and the secret with: npm run hash-password
#
# NEVER commit a real .env — .gitignore already excludes it.

ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator

# PBKDF2 hash of the admin password. The password itself is stored nowhere.
ADMIN_PASSWORD_HASH=REPLACE_ME

# Signs session tokens. 32 random bytes, base64. Changing it signs everyone out.
AUTH_SECRET=REPLACE_ME

# How long a sign-in lasts, in minutes.
SESSION_MINUTES=240
